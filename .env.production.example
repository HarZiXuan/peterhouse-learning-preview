# Copy to .env.production on the server (chmod 600, owned by the deploy user). NEVER commit the real file.
# Used by docker-compose.prod.yml both for variable substitution and as the backend's environment.
# Keep values unquoted and on one line.

# ── Database ─────────────────────────────────────────────────────────────────────────────────────
# Used by the db container and put into DATABASE_URL by compose. Use hex so it is URL-safe:
#   openssl rand -hex 24
POSTGRES_PASSWORD=change-me-run-openssl-rand-hex-24

# ── Encryption (the most important secret) ───────────────────────────────────────────────────────
# Child names, notes, reports and photos are encrypted with this before they reach the database.
# Format id:base64key[,id2:base64key2]. The FIRST key encrypts new data; all listed keys can decrypt.
# Generate one:  npm run gen-key -w backend      (prints k1:<44 base64 characters>)
# LOSE THIS AND EVERY BACKUP IS UNREADABLE. Keep an offline copy / password-manager entry, separate from the DB backups.
DATA_ENCRYPTION_KEYS=k1:REPLACE_WITH_OUTPUT_OF_gen-key

# ── Site ─────────────────────────────────────────────────────────────────────────────────────────
# The address people type in the browser. Used for the cross-site-request origin check. No trailing slash.
PUBLIC_ORIGIN=https://reviews.example.com
# 1 = session cookie is HTTPS-only. Keep 1 in production.
COOKIE_SECURE=1

# ── Sign-in limits (defaults shown; remove the # to change) ──────────────────────────────────────
# SESSION_IDLE_HOURS=12
# SESSION_MAX_DAYS=7
# LOGIN_RATE_LIMIT=20

# ── Writing service (optional) ───────────────────────────────────────────────────────────────────
# With no key the built-in sentence bank is used. Names are never sent (see backend/src/domain/anonymise.ts).
AI_PROVIDER=
GEMINI_API_KEY=
OPENAI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash
# OPENAI_MODEL=gpt-4.1-mini

# ── Image selection (written by the deploy workflow into .deploy.env; usually leave alone) ───────
# BACKEND_IMAGE=ghcr.io/OWNER/REPO/backend
# FRONTEND_IMAGE=ghcr.io/OWNER/REPO/frontend
# IMAGE_TAG=latest

# Set inside the images / compose, so not listed here: NODE_ENV, PORT, DATABASE_URL, FRONTEND_INTERNAL_URL,
# CHROME_PATH, CHROME_NO_SANDBOX, MIGRATIONS_DIR, SKILL_DIR.
