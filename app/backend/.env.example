# Local development settings. Copy to backend/.env (git-ignored). Everything has a safe development default,
# so the app also runs with no .env at all against `pnpm db:up`.

# Where Postgres is (the docker-compose.yml database).
DATABASE_URL=postgres://peterhouse:peterhouse@127.0.0.1:5432/peterhouse
PORT=4100

# Writing service. Set a key and that service is used; AI_PROVIDER is optional (gemini | openai | local | sentence_bank).
# With no key the built-in sentence bank writes the reports.
GEMINI_API_KEY=
OPENAI_API_KEY=
AI_PROVIDER=

# Development uses a built-in, publicly known encryption key. A real server MUST set its own:
#   pnpm --filter @peterhouse/backend gen-key      → k1:<base64>
# Keep a copy somewhere safe and separate from the database backups: without it the data cannot be read.
DATA_ENCRYPTION_KEYS=

# Printing PDFs: the backend opens the frontend's report page in Chrome.
FRONTEND_INTERNAL_URL=http://127.0.0.1:3000
CHROME_PATH=
