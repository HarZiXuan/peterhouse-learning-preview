# Copy to .env.local (development) or the server's env file (production). Never commit the real file.

# Staff login. Required in production; in development the app is open if these are empty.
APP_LOGIN_USER=
APP_LOGIN_PASSWORD=
# Signs the login cookie. Use a long random string (openssl rand -hex 32). Falls back to a value derived from the login.
SESSION_SECRET=
# Set to 1 when the site is served over HTTPS.
COOKIE_SECURE=

# Writing service. Set a key and that service is used; AI_PROVIDER is optional (gemini | openai | local | sentence_bank).
AI_PROVIDER=
GEMINI_API_KEY=
OPENAI_API_KEY=

# Optional
DATA_DIR=
CHROME_PATH=
CHROME_NO_SANDBOX=
