[Unit]
Description=Peterhouse Learning Review: encrypted database backup
After=docker.service
Requires=docker.service

[Service]
Type=oneshot
EnvironmentFile=/etc/peterhouse/backup.env
ExecStart=/opt/peterhouse/infra/server/backup.sh
# Runs as root only because it needs the docker socket. It writes under /var/backups/peterhouse and nowhere else.
NoNewPrivileges=true
ProtectHome=read-only
ProtectSystem=strict
ReadWritePaths=/var/backups/peterhouse
PrivateTmp=true
