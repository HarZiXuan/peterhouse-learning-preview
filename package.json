{
  "name": "peterhouse-learning-review",
  "private": true,
  "scripts": {
    "db:up": "docker compose up -d db",
    "db:down": "docker compose down",
    "migrate": "pnpm --filter @peterhouse/backend migrate",
    "dev:backend": "pnpm --filter @peterhouse/backend dev",
    "dev:frontend": "pnpm --filter @peterhouse/frontend dev",
    "build": "pnpm -r --filter @peterhouse/backend --filter @peterhouse/frontend build",
    "test": "pnpm --filter @peterhouse/backend test",
    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm --filter @peterhouse/frontend lint"
  },
  "engines": {
    "node": ">=22",
    "pnpm": ">=10"
  },
  "packageManager": "pnpm@10.33.2"
}
