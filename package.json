{
  "name": "peterhouse-learning-review",
  "private": true,
  "workspaces": ["shared", "backend", "frontend"],
  "scripts": {
    "db:up": "docker compose up -d db",
    "db:down": "docker compose down",
    "migrate": "npm run migrate -w backend",
    "dev:backend": "npm run dev -w backend",
    "dev:frontend": "npm run dev -w frontend",
    "build": "npm run build -w backend && npm run build -w frontend",
    "test": "npm test -w backend",
    "typecheck": "npm run typecheck -w shared && npm run typecheck -w backend && npm run typecheck -w frontend",
    "lint": "npm run lint -w frontend"
  },
  "engines": { "node": ">=22" }
}
