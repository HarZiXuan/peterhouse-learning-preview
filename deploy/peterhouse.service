[Unit]
Description=Peterhouse Learning Review (Next.js)
After=network.target

[Service]
Type=simple
User=peterhouse
Group=peterhouse
WorkingDirectory=/opt/peterhouse/app
EnvironmentFile=/opt/peterhouse/.env
ExecStart=/usr/bin/node node_modules/next/dist/bin/next start --port 3200 --hostname 127.0.0.1
Restart=always
RestartSec=5
# Shared 2 GB box with other sites: keep this app (and the Chrome it starts for PDFs) in its own budget.
MemoryMax=900M
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ReadWritePaths=/opt/peterhouse

[Install]
WantedBy=multi-user.target
